	(text_box "The CP2102 module does not require the USB 3.x TX+/TX- and RX+/RX- pins, \nas it only supports USB 2.0 communication via D+ and D-."
		(exclude_from_sim no)
		(at 118.745 47.625 0)
		(size 24.765 18.415)
		(margins 0.9525 0.9525 0.9525 0.9525)
